+/* Dlaždice jsou vyšší než glóbus — glóbus drží vedle nich na místě. */
+@media (min-width: 901px) {
+  .globe-layout { align-items: start; }
+  .globe-layout .globe-wrap { position: sticky; top: calc(var(--header-h, 84px) + 40px); }
+}
+
+/* NÁVRH (?oblouk): karty v půlkruhu kolem pravé strany glóbusu. Pozice počítá
+   CSS cos()/sin() z pořadí karty (--i) a jejich počtu (--n). */
+@media (min-width: 1000px) {
+  .globe-layout.is-arc { --g: 540px; --r: 345px; display: block; position: relative; height: 720px; max-width: 960px; margin: 0 auto; }
+  .is-arc .globe-wrap { position: absolute; left: 0; top: 50%; width: var(--g); transform: translateY(-50%); }
+  .is-arc .cont-tiles { position: absolute; inset: 0; display: block; }
+  .is-arc .cont-tiles li {
+    --a: calc((var(--i) - (var(--n) - 1) / 2) * 21deg);
+    position: absolute;
+    width: 270px;
+    left: calc(var(--g) / 2 + var(--r) * cos(var(--a)));
+    top: calc(50% + var(--r) * sin(var(--a)));
+    transform: translateY(-50%);
+  }
+  .is-arc .cont-tile { flex-direction: row; height: 68px; }
+  .is-arc .cont-tile-media,
+  .is-arc .cont-tiles li:last-child:nth-child(odd) .cont-tile-media { aspect-ratio: auto; flex: 0 0 96px; }
+  .is-arc .cont-tile-body { align-items: flex-start; text-align: left; padding: 8px 16px; border-top: 0; border-left: 1px solid var(--gold); }
+  .is-arc .cont-tile-name { font-size: 15px; }
+  .is-arc .cont-tile-count { font-size: 10px; }
+}
 
