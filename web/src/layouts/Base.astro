---
export interface Props {
  title: string;
  description?: string;
  activeNav?: 'o-nas' | 'destinace' | 'reference' | 'zazitky' | 'kontakt' | '';
  /** Homepage má full-bleed video hero — hlavička tam začíná průhledná a
   * po odscrollování zezlátne/zkrémovatí (řídí js/main.js přes .scrolled).
   * Ostatní stránky nemají hero pod hlavičkou, takže zůstávají "page-light"
   * (hlavička je vždy krémová, bez ohledu na scroll). */
  transparentHero?: boolean;
}

const {
  title,
  description = 'Snail Travel — exkluzivní česká luxusní cestovní agentura.',
  activeNav = '',
  transparentHero = false,
} = Astro.props;
---
<!DOCTYPE html>
<html lang="cs">
<head>
<meta charset="UTF-8" />
<meta name="viewport" content="width=device-width, initial-scale=1" />
<title>{title}</title>
<meta name="description" content={description} />
<base href={import.meta.env.BASE_URL} />
<link rel="icon" href="assets/logo-mark.png" type="image/png" />
<link rel="preconnect" href="https://fonts.googleapis.com" />
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
<link href="https://fonts.googleapis.com/css2?family=Cinzel:wght@400;500;600;700&family=Cormorant+Garamond:wght@400;500;600&family=Inter:wght@300;400;500;600&family=Playfair+Display:wght@400;500;600;700&display=swap" rel="stylesheet" />
<link rel="stylesheet" href="css/style.css?v=47" />
<link rel="stylesheet" href="css/destinace-detail.css?v=2" />
</head>
<body class:list={[{ 'page-light': !transparentHero }]}>

<!-- ============ HEADER (sdíleno napříč stránkami, viz web/CLAUDE.md) ============ -->
<header class:list={['site-header', { scrolled: !transparentHero }]} id="header">
  <div class="header-inner">
    <a href="." class="brand" aria-label="Snail Travel — domů">
      <img class="brand-mark" src="assets/logo-mark.png" alt="" />
      <span class="brand-name">Snail&nbsp;Travel</span>
    </a>

    <nav class="nav" aria-label="Hlavní navigace">
      <a href="o-nas" class={activeNav === 'o-nas' ? 'is-active' : ''}>O nás</a>
      <a href="destinace" class={activeNav === 'destinace' ? 'is-active' : ''}>Destinace</a>
      <a href="reference" class={activeNav === 'reference' ? 'is-active' : ''}>Reference</a>
      <a href="#zazitky" class={activeNav === 'zazitky' ? 'is-active' : ''}>Zážitky</a>
      <a href="#kontakt" class={activeNav === 'kontakt' ? 'is-active' : ''}>Kontakt</a>
      <a href="https://www.snailtravelgolf.cz/" target="_blank" rel="noopener">Golf</a>
    </nav>

    <a href="#kontakt" class="btn btn-pill nav-cta">Naplánovat cestu</a>

    <button class="menu-toggle" id="menuToggle" aria-label="Otevřít menu" aria-expanded="false">
      <span></span><span></span>
    </button>
  </div>
</header>

<!-- Mobile drawer -->
<div class="mobile-nav" id="mobileNav" aria-hidden="true">
  <a href="o-nas">O nás</a>
  <a href="destinace">Destinace</a>
  <a href="reference">Reference</a>
  <a href="#filozofie">Filozofie</a>
  <a href="#zazitky">Zážitky</a>
  <a href="#kontakt">Kontakt</a>
  <a href="https://www.snailtravelgolf.cz/" target="_blank" rel="noopener">Golf</a>
  <a href="#kontakt" class="btn btn-pill">Naplánovat cestu</a>
</div>

<main id="top">
  <slot />
</main>

<!-- ============ FOOTER (sdíleno napříč stránkami) ============ -->
<footer class="site-footer">
  <div class="wrap footer-grid">
    <div class="footer-brand">
      <img class="footer-logo" src="assets/logo-full.png" alt="Snail Travel" />
      <p class="footer-tag">Umění cestovat pomalu.</p>
    </div>
    <nav class="footer-nav" aria-label="Patička">
      <a href="o-nas">O nás</a>
      <a href="destinace">Destinace</a>
      <a href="reference">Reference</a>
      <a href="#filozofie">Filozofie</a>
      <a href="#zazitky">Zážitky</a>
      <a href="#kontakt">Kontakt</a>
    </nav>
    <div class="footer-contact">
      <a href="mailto:barbora@snailtravel.cz">barbora@snailtravel.cz</a>
      <a href="tel:+420602552624">+420&nbsp;602&nbsp;552&nbsp;624</a>
    </div>
    <div class="footer-legal">
      <p class="footer-legal-company">
        Cestovní kancelář<br />
        SNAIL TRAVEL INTERNATIONAL a.s.<br />
        Veleslavínova 6, 110 00 Praha 1
      </p>
      <p class="footer-legal-contact">
        mob.: <a href="tel:+420602552624">+420&nbsp;602&nbsp;552&nbsp;624</a>, <a href="tel:+420725713335">+420&nbsp;725&nbsp;713&nbsp;335</a><br />
        e-mail: <a href="mailto:info@snailtravel.cz">info@snailtravel.cz</a>
      </p>
      <p class="footer-legal-notice">
        <strong>Právní doložka</strong><br />
        Veškerý obsah na těchto stránkách má ve vlastnictví Snail Travel
        International a.s., není-li uvedeno jinak. Použití nebo reprodukce
        obsahu na těchto stránkách je trestná bez předešlého souhlasu
        společnosti.
      </p>
    </div>
  </div>
  <div class="footer-bottom">
    <span>© 2026 Snail Travel International a.s. Všechna práva vyhrazena.</span>
    <span>Soukromé luxusní cesty na míru.</span>
  </div>
</footer>

<script is:inline src="js/main.js?v=7"></script>
<script is:inline src="js/ref-quotes.js?v=1"></script>
<script is:inline src="js/dest-references.js?v=1"></script>
<script is:inline src="js/dest-toc.js?v=2"></script>
<script is:inline src="js/search-index.js?v=4"></script>
<script is:inline src="js/header-search.js?v=2"></script>
<script is:inline src="js/popup.js?v=4"></script>
</body>
</html>
