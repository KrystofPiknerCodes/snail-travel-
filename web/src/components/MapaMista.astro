---
// Mapa polohy JEDNOHO místa — destinace, oblasti nebo hotelu (jeden
// špendlík, žádný shluk více bodů). Nahrazuje starší MapaOblasti.astro,
// která kreslila všechny hotely destinace najednou — na přání Krystof,
// září 2026: "mapa by měla u destinace/oblasti/hotelu ukázat, kde SE
// NACHÁZÍ ta destinace/oblast/hotel", ne přehled hotelů v okolí.
//
// Leaflet + dlaždice OpenStreetMap (npm balíček, ne Google Maps a ne CDN —
// viz zadání: klíč, cena, cookie souhlas navíc). Samotná knihovna (JS+CSS)
// i dlaždice se načtou, až uživatel na mapu doscrolluje (IntersectionObserver
// v inline scriptu níže) — kvůli rychlosti načtení zbytku stránky.
//
// Volitelné pole `mapa`/`poloha` v obsahové kolekci → komponenta se
// vykresluje, jen když volající stránka souřadnice má (podmínka je v
// [...slug].astro, ne tady — kvůli rozcestníku, který o existenci sekce
// potřebuje vědět ještě před renderem téhle komponenty).
export interface Props {
  lat: number;
  lng: number;
  zoom: number;
  nazev: string;
  kicker?: string;
}

const { lat, lng, zoom, nazev, kicker = 'Mapa' } = Astro.props;
---

<section class="section" id="mapa" style="background: var(--cream-2);">
  <div class="wrap">
    <header class="section-head reveal">
      <p class="kicker">{kicker}</p>
      <h2 class="display">Kde se nachází {nazev}</h2>
    </header>

    <div
      class="dest-map reveal"
      data-delay="1"
      id="destMap"
      data-lat={lat}
      data-lng={lng}
      data-zoom={zoom}
      data-nazev={nazev}
      role="img"
      aria-label={`Mapa s polohou ${nazev}`}
    >
      <div class="dest-map-ph" aria-hidden="true">Mapa se načte po přiblížení…</div>
    </div>
  </div>
</section>

<script>
  function initMap(container: HTMLElement) {
    if (container.dataset.mapInited === '1') return;
    container.dataset.mapInited = '1';

    const lat = parseFloat(container.dataset.lat || '0');
    const lng = parseFloat(container.dataset.lng || '0');
    const zoom = parseInt(container.dataset.zoom || '13', 10);
    const nazev = container.dataset.nazev || '';

    // Leaflet je npm závislost (ne CDN) — importuje se dynamicky až tady,
    // aby se JS ani CSS knihovny netahaly, dokud uživatel na mapu nedoscrolluje.
    Promise.all([import('leaflet'), import('leaflet/dist/leaflet.css')]).then(([leafletMod]) => {
      const L = (leafletMod as any).default ?? leafletMod;
      const ph = container.querySelector('.dest-map-ph');
      if (ph) ph.remove();

      const map = L.map(container, {
        center: [lat, lng],
        zoom,
        // Mapa nesmí zabrat scroll kolečkem, když jí uživatel jen
        // projíždí při scrollování stránky — zapne se až po kliknutí.
        scrollWheelZoom: false,
      });

      L.tileLayer('https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png', {
        maxZoom: 19,
        attribution:
          '&copy; <a href="https://www.openstreetmap.org/copyright" target="_blank" rel="noopener">OpenStreetMap</a> přispěvatelé',
      }).addTo(map);

      map.on('click', () => map.scrollWheelZoom.enable());
      container.addEventListener('mouseleave', () => map.scrollWheelZoom.disable());

      const goldIcon = L.divIcon({
        className: 'dest-map-pin',
        html:
          '<svg width="28" height="38" viewBox="0 0 30 40" xmlns="http://www.w3.org/2000/svg">' +
          '<path d="M15 0C6.7 0 0 6.7 0 15c0 10.5 15 25 15 25s15-14.5 15-25C30 6.7 23.3 0 15 0z" fill="#BD9A45"/>' +
          '<circle cx="15" cy="15" r="6" fill="#211E18"/>' +
          '</svg>',
        iconSize: [28, 38],
        iconAnchor: [14, 38],
        popupAnchor: [0, -34],
      });

      L.marker([lat, lng], { icon: goldIcon, title: nazev, alt: nazev })
        .addTo(map)
        .bindPopup(nazev)
        .openPopup();

      window.requestAnimationFrame(() => map.invalidateSize());
    });
  }

  function setup() {
    const el = document.getElementById('destMap');
    if (!el) return;

    if (!('IntersectionObserver' in window)) {
      initMap(el);
      return;
    }

    const io = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          if (entry.isIntersecting) {
            initMap(entry.target as HTMLElement);
            io.unobserve(entry.target);
          }
        });
      },
      { rootMargin: '200px 0px' }
    );
    io.observe(el);
  }

  setup();
</script>
