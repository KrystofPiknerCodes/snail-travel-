---
// Výpiska destinací — Astro náhrada za statický destinace.html (viz
// CLAUDE.md "Astro verze" a úkol migrace katalogu zemí, srpen 2026).
//
// Pozor na routing: tahle stránka obsluhuje přesně `/destinace` (prázdný
// slug), zatímco `[...slug].astro` vyžaduje aspoň jeden segment a jeho
// getStaticPaths ho nikdy negeneruje prázdný — nekoliduje.
//
// Vizuál a chování (globus, vyhledávání, odznaky referencí) je zachované
// 1:1 podle starého destinace.html — jen zdroj dat je teď content
// collection `destinace` místo natvrdo psaného HTML.
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';

const vse = await getCollection('destinace');
// Top-level destinace = typ 'destinace' (oblasti typu Funchal/ostrovy Seychel
// jsou typ 'oblast' a do výpisky kontinentů nepatří — viz content.config.ts).
const destinace = vse.filter((d) => d.data.typ === 'destinace');

const KONTINENTY = [
  { kod: 'EU', id: 'kontinent-evropa', trida: '', kicker: 'Destinace · Evropa', nadpis: 'Kontinent u dosahu', vLokaci: 'v Evropě' },
  { kod: 'AF', id: 'kontinent-afrika', trida: 'alt', kicker: 'Destinace · Afrika', nadpis: 'Divoké kontinentální srdce', vLokaci: 'v Africe' },
  { kod: 'AS', id: 'kontinent-asie', trida: '', kicker: 'Destinace · Asie', nadpis: 'Vůně a barvy Východu', vLokaci: 'v Asii' },
  { kod: 'NA', id: 'kontinent-amerika-sever', trida: 'alt', kicker: 'Destinace · Střední &amp; Severní Amerika', nadpis: 'Od kaňonů po karibské pláže', vLokaci: 've Střední a Severní Americe' },
  { kod: 'SA', id: 'kontinent-amerika-jih', trida: '', kicker: 'Destinace · Jižní Amerika', nadpis: 'Andy, Amazonie, konec světa', vLokaci: 'v Jižní Americe' },
  { kod: 'OC', id: 'kontinent-australie', trida: 'alt', kicker: 'Destinace · Austrálie a Oceánie', nadpis: 'Ostrovy na konci mapy', vLokaci: 'v Austrálii a Oceánii' },
] as const;

// Kolik destinací na kontinent se ukáže rovnou — zbytek jde za tlačítko
// "Zobrazit všechny destinace", ať mřížka nepůsobí jako nekonečný výpis všech
// zemí. Vybrané destinace (vybrana: true — to, co chceme prodávat) jdou vždy
// první, zbytek abecedně za nimi.
const VIDITELNYCH = 10;

// GitHub Pages běží pod podadresářem (viz astro.config.mjs SITE_BASE) — Base.astro
// řeší statické cesty přes <base>, ale absolutní cesty uložené přímo v obsahu
// (např. hlavni_foto: "/assets/...") a dynamicky skládané odkazy je potřeba
// zbavit úvodního lomítka ručně, ať zůstanou relativní vůči <base>.
const rel = (p: string) => p.replace(/^\//, '');

function poKontinentu(kod: string) {
  return destinace
    .filter((d) => d.data.kontinent === kod)
    .sort((a, b) => {
      if (a.data.vybrana !== b.data.vybrana) return a.data.vybrana ? -1 : 1;
      return a.data.nazev.localeCompare(b.data.nazev, 'cs');
    });
}
---
<Base
  title="Destinace — Snail Travel"
  description="Objevte destinace Snail Travel — vyberte kontinent nebo vyhledejte konkrétní zemi."
  activeNav="destinace"
>

  <!-- ============ PAGE HEAD ============ -->
  <section class="section dest-head">
    <div class="wrap">
      <p class="kicker reveal">Destinace</p>
      <h1 class="display reveal" data-delay="1">Vyberte si, kam vás<br />zavedeme</h1>
      <p class="dest-lead reveal" data-delay="2">
        Zvolte kontinent na mapě níže, nebo napište zemi, která vás láká. Každou
        cestu tvoříme na míru — s&nbsp;pokorou k&nbsp;místu i&nbsp;času.
      </p>

      <form class="dest-search reveal" data-delay="3" role="search" onsubmit="return false;">
        <svg class="dest-search-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <circle cx="11" cy="11" r="7" />
          <path d="M20 20 L16 16" />
        </svg>
        <input type="search" id="destSearch" placeholder="Hledat destinaci — např. Bali, Madeira, Keňa…" autocomplete="off" spellcheck="false" />
        <button type="button" class="dest-search-clear" id="destSearchClear" aria-label="Vymazat">×</button>
      </form>
      <p class="dest-search-hint" id="destSearchHint" aria-live="polite"></p>
    </div>
  </section>

  <!-- ============ GLOBUS ============ -->
  <section class="section dest-map-section" id="mapa">
    <div class="wrap">
      <p class="dest-map-caption reveal">Otočte glóbus a&nbsp;klikněte na kontinent, který vás láká.</p>

      <div class="globe-wrap reveal" data-delay="1">
        <div class="globe-backdrop" aria-hidden="true">
          <svg viewBox="0 0 900 900" class="globe-backdrop-grid" preserveAspectRatio="xMidYMid meet">
            <circle cx="450" cy="450" r="200" />
            <circle cx="450" cy="450" r="290" />
            <circle cx="450" cy="450" r="380" />
            <circle cx="450" cy="450" r="440" />
            <g class="globe-backdrop-spokes">
              <line x1="450" y1="10" x2="450" y2="890" />
              <line x1="10" y1="450" x2="890" y2="450" />
              <line x1="123" y1="123" x2="777" y2="777" />
              <line x1="777" y1="123" x2="123" y2="777" />
              <line x1="450" y1="70" x2="450" y2="830" transform="rotate(30 450 450)" />
              <line x1="450" y1="70" x2="450" y2="830" transform="rotate(60 450 450)" />
              <line x1="450" y1="70" x2="450" y2="830" transform="rotate(120 450 450)" />
              <line x1="450" y1="70" x2="450" y2="830" transform="rotate(150 450 450)" />
            </g>
          </svg>
        </div>
        <div class="globe-stage" id="globe" aria-label="Interaktivní glóbus se&nbsp;seznamem destinací">
          <div class="globe-loading">Nahrávám glóbus…</div>
        </div>
        <div class="globe-tooltip" id="globeTooltip" aria-hidden="true"></div>
      </div>
    </div>
  </section>

  <!-- ============ SEKCE PODLE KONTINENTU ============ -->
  {KONTINENTY.map((k) => {
    const zeme = poKontinentu(k.kod);
    const gridId = `grid-${k.id}`;
    const skryte = Math.max(0, zeme.length - VIDITELNYCH);
    return (
      <section class={`section continent-block ${k.trida}`} id={k.id} data-continent={k.id.replace('kontinent-', '')}>
        <div class="wrap">
          <header class="continent-head reveal">
            <p class="kicker" set:html={k.kicker} />
            <h2 class="display" set:html={k.nadpis} />
            <p class="continent-sub">Vyberte si, kam chcete jet na dovolenou podle&nbsp;země.</p>
          </header>
          <ul class="country-grid reveal" data-delay="1" id={gridId}>
            {zeme.map((d, i) => (
              <li class={`${d.data.vybrana ? 'is-featured ' : ''}${i >= VIDITELNYCH ? 'is-more' : ''}`}>
                <a href={`destinace/${d.id}`}>
                  <img
                    class="country-photo"
                    src={rel(d.data.hlavni_foto)}
                    alt={d.data.nazev}
                    loading="lazy"
                    width="400"
                    height="500"
                  />
                  <span class="country-name">{d.data.nazev}</span>
                </a>
              </li>
            ))}
          </ul>
          {skryte > 0 && (
            <div class="cta-row country-grid-cta">
              <button class="btn btn-ghost country-grid-toggle" type="button" aria-expanded="false" aria-controls={gridId}>
                <span class="btn-ghost-label">Zobrazit všechny destinace {k.vLokaci} ({zeme.length})</span>
              </button>
            </div>
          )}
        </div>
      </section>
    );
  })}

  <!-- ============ CTA BAND ============ -->
  <section class="section dest-cta-band">
    <div class="wrap">
      <div class="dest-cta-inner reveal">
        <h2 class="display">Nenašli jste svou destinaci?</h2>
        <p>Rádi ji připravíme na míru. Napište nám, kam vás to láká — ozveme se do&nbsp;48&nbsp;hodin.</p>
        <a href="#kontakt" class="btn btn-pill">Naplánovat cestu</a>
      </div>
    </div>
  </section>

</Base>

<script is:inline src="js/ref-counts.js?v=1"></script>
<script is:inline src="js/dest-refs.js?v=2"></script>
<script is:inline src="js/destinations.js?v=4"></script>
<script is:inline src="https://cdn.jsdelivr.net/npm/d3@7.9.0/dist/d3.min.js"></script>
<script is:inline src="https://cdn.jsdelivr.net/npm/topojson-client@3.1.0/dist/topojson-client.min.js"></script>
<script is:inline src="js/globe.js?v=4"></script>
