---
// Jedna šablona pro celý strom Destinace/Oblast/Hotel (klientovo zadání:
// Hlavní strana > Destinace > Evropa > Madeira > Funchal > Hotel).
//
// URL segmenty i drobečková navigace se počítají generickým procházením
// `nadrazena` (web/src/lib/hierarchie.ts) do libovolné hloubky — přidání
// další destinace, oblasti nebo hotelu (i bez oblasti) proto nevyžaduje
// úpravu routeru, jen nový soubor v content/destinace nebo content/hotel.
import { getCollection, render } from 'astro:content';
import type { CollectionEntry } from 'astro:content';
import Base from '../../layouts/Base.astro';
import Rozcestnik from '../../components/Rozcestnik.astro';
import MapaMista from '../../components/MapaMista.astro';
import CenaTag from '../../components/CenaTag.astro';
import PhotoSwiper from '../../components/PhotoSwiper.astro';
import {
  indexDestinace,
  resolveAncestors,
  childOblasti,
  buildBreadcrumb,
  resolveKontinent,
  KONTINENT_NAZEV,
  type DestEntry,
  type HotelEntry,
} from '../../lib/hierarchie';

type Kind = 'destinace' | 'oblast' | 'hotel';

interface Props {
  kind: Kind;
  entry: DestEntry | HotelEntry;
  chain: DestEntry[];
  destinaceAll: DestEntry[];
  hotelyAll: HotelEntry[];
}

export async function getStaticPaths() {
  const destinaceAll = await getCollection('destinace');
  const hotelyAll = await getCollection('hotel');
  const destinaceById = indexDestinace(destinaceAll);

  const paths: Array<{ params: { slug: string }; props: Props }> = [];

  for (const entry of destinaceAll) {
    const chain = resolveAncestors(entry.data.nadrazena, destinaceById);
    const segments = [...chain.map((c) => c.id), entry.id];
    paths.push({
      params: { slug: segments.join('/') },
      props: {
        kind: entry.data.typ === 'oblast' ? 'oblast' : 'destinace',
        entry,
        chain,
        destinaceAll,
        hotelyAll,
      },
    });
  }

  for (const hotel of hotelyAll) {
    const chain = resolveAncestors(hotel.data.nadrazena, destinaceById);
    const segments = [...chain.map((c) => c.id), hotel.id];
    paths.push({
      params: { slug: segments.join('/') },
      props: { kind: 'hotel', entry: hotel, chain, destinaceAll, hotelyAll },
    });
  }

  return paths;
}

const { kind, entry, chain, destinaceAll, hotelyAll } = Astro.props as Props;
const { Content } = await render(entry as any);

const breadcrumb = buildBreadcrumb(entry, chain);
const kontinent = resolveKontinent(entry, chain);
const basePath = 'destinace/' + [...chain.map((c) => c.id), entry.id].join('/');
// GitHub Pages běží pod podadresářem (SITE_BASE, viz astro.config.mjs) — Base.astro
// nastavuje <base>, takže interní odkazy/obrázky musí být relativní (bez úvodního
// lomítka); absolutní cesty uložené v obsahu (např. hlavni_foto) je potřeba očistit.
const rel = (p: string) => p.replace(/^\//, '');

// ---- Destinace i Oblast sdílejí stejná data (obě žijí v kolekci `destinace`) ----
const d = kind !== 'hotel' ? (entry as DestEntry).data : null;

// Přímo podřazené oblasti (jen relevantní pro kind === 'destinace'/'oblast',
// oblast může mít v budoucnu vlastní podoblasti, i když to zadání nevyžaduje).
const oblasti = kind !== 'hotel' ? childOblasti(entry.id, destinaceAll) : [];

// Hotely přímo podřazené tomuto uzlu (bez mezičlánku oblasti).
const hotelyPrime = kind !== 'hotel' ? hotelyAll.filter((h) => h.data.nadrazena === entry.id) : [];

// ---- Hotel ----
const h = kind === 'hotel' ? (entry as HotelEntry).data : null;
// Galerie pro PhotoSwiper — bez vyplněné `galerie` spadne na jediné `foto`,
// ať sekce "Fotografie hotelu" funguje i u hotelů, které galerii ještě nemají.
const hotelGalerie =
  h && h.galerie.length > 0 ? h.galerie : h?.foto ? [{ src: h.foto, alt: h.nazev }] : [];

const tocItems =
  kind === 'destinace' && d
    ? ([
        { id: 'info', label: 'Info' },
        (oblasti.length > 0 || hotelyPrime.length > 0) && { id: 'ubytovani', label: 'Destinace' },
        d.galerie.length > 0 && { id: 'fotogalerie', label: 'Fotogalerie' },
        d.kdy_jet.length > 0 && { id: 'kdy-jet', label: 'Kdy jet' },
        d.mapa && { id: 'mapa', label: 'Mapa' },
        d.zazitky.length > 0 && { id: 'zazitky', label: 'Zážitky' },
        d.golf.length > 0 && { id: 'golf', label: 'Golf' },
        d.ref_tag && { id: 'reference', label: 'Reference' },
      ].filter(Boolean) as Array<{ id: string; label: string }>)
    : [];

const pageTitle =
  kind === 'hotel'
    ? `${h!.nazev} — ${chain[chain.length - 1]?.data.nazev ?? ''} — Snail Travel`
    : `${d!.nazev} — Destinace — Snail Travel`;
const pageDescription =
  kind === 'hotel' ? `${h!.nazev}${h!.misto ? `, ${h!.misto}` : ''}` : d!.perex ?? d!.nazev;
---

<Base title={pageTitle} description={pageDescription} activeNav="destinace">

  <!-- ============ HERO ============ -->
  <section class={`section dest-head ${(kind !== 'hotel' && d?.hlavni_foto) ? 'dest-head-photo dest-head-slider' : ''}`}>
    {kind !== 'hotel' && d?.hlavni_foto && (
      d.galerie && d.galerie.length > 1 ? (
        <div class="dest-hero-slider" id="destHeroSlider" aria-hidden="true">
          {d.galerie.slice(0, 4).map((img, i) => (
            <div class={`dest-hero-slide ${i === 0 ? 'is-active' : ''}`} style={`background-image: url('${img.src}')`}></div>
          ))}
          <div class="dest-hero-overlay"></div>
          <div class="dest-hero-dots">
            {d.galerie.slice(0, 4).map((_, i) => (
              <button type="button" class={`dest-hero-dot ${i === 0 ? 'is-active' : ''}`} data-slide={i} aria-label={`Fotka ${i + 1}`}></button>
            ))}
          </div>
        </div>
      ) : (
        <div class="dest-head-bg" style={`background-image: url('${d.hlavni_foto}')`} aria-hidden="true"></div>
      )
    )}
    <div class="wrap">
      <nav class="crumb reveal" aria-label="Drobečková navigace">
        {breadcrumb.map((c, i) => (
          <>
            {i > 0 && <span class="crumb-sep">/</span>}
            {c.href ? <a href={c.href}>{c.label}</a> : <span class="crumb-current">{c.label}</span>}
          </>
        ))}
      </nav>

      {kind === 'hotel' ? (
        <>
          <p class="kicker kicker-light reveal" data-delay="1">
            Hotel{h!.misto ? ` · ${h!.misto}` : ''}
          </p>
          <h1 class="display reveal" data-delay="2">{h!.nazev}</h1>
          <div class="hotel-hero-meta reveal" data-delay="3">
            {h!.hvezdy ? <div class="hotel-stars">{'★'.repeat(h!.hvezdy)}</div> : <span />}
            <CenaTag cenaOd={h!.cena_od} variant="hero" />
          </div>
        </>
      ) : (
        <>
          <p class="kicker kicker-light reveal" data-delay="1">
            {kind === 'oblast'
              ? `Oblast · ${chain.map((c) => c.data.nazev).join(' · ')}`
              : `Destinace · ${kontinent ? KONTINENT_NAZEV[kontinent] : ''}${chain.length === 0 && d?.nadrazena ? ` · ${d.nadrazena}` : ''}`}
          </p>
          <h1 class="display reveal" data-delay="2">{d!.nazev}</h1>
        </>
      )}
    </div>
  </section>

  {kind === 'destinace' && <Rozcestnik items={tocItems} />}

  {kind === 'hotel' ? (
    <>
      <!-- ============ FOTO HOTELU ============ -->
      <section class="section" id="info">
        <div class="wrap">
          {hotelGalerie.length > 0 ? (
            <PhotoSwiper images={hotelGalerie} rel={rel} />
          ) : (
            <div class="hotel-photo-ph" style="height:320px;">⚠ Foto hotelu chybí — doplnit od klienta</div>
          )}
        </div>
      </section>

      <!-- ============ POLOHA ============ -->
      {h!.poloha ? (
        <MapaMista lat={h!.poloha.lat} lng={h!.poloha.lng} zoom={15} nazev={h!.nazev} kicker="Poloha" />
      ) : (
        <section class="section" style="padding-top:0;">
          <div class="wrap dest-about">
            <div class="chybi-box reveal">
              <strong>⚠ Doplnit od klienta</strong>
              Přesnou polohu hotelu zatím nemáme.
            </div>
          </div>
        </section>
      )}

      <!-- ============ CTA ============ -->
      <section class="section dest-cta-band">
        <div class="wrap">
          <div class="dest-cta-inner reveal">
            <h2 class="display">Naplánujme spolu pobyt v {h!.nazev}</h2>
            <p>
              Bára Blaschke se vám ozve do 48 hodin s nabídkou na míru.
              <br />
              <a href="mailto:barbora@snailtravel.cz">barbora@snailtravel.cz</a>
              &nbsp;·&nbsp;
              <a href="tel:+420602552624">+420&nbsp;602&nbsp;552&nbsp;624</a>
            </p>
            <a href="#kontakt" class="btn btn-pill">Naplánovat cestu</a>
            <p style="margin-top:18px;"><a href={`destinace/${[...chain.map((c) => c.id)].join('/')}`}>&larr; Zpět na {chain[chain.length - 1]?.data.nazev}</a></p>
          </div>
        </div>
      </section>
    </>
  ) : (
    <>
      <!-- ============ ÚRYVEK + INFO ============ -->
      <section class="section" id="info">
        <div class="wrap">
          {d!.perex ? (
            <p class="lead dest-excerpt reveal">{d!.perex}</p>
          ) : (
            <p class="lead dest-excerpt reveal">⚠ Doplnit od klienta — popis destinace zatím chybí.</p>
          )}
          <div class="dest-about reveal" data-delay="1">
            <Content />
          </div>
        </div>
      </section>

      <!-- ============ UBYTOVÁNÍ (oblasti, nebo přímo hotely, pokud oblast chybí) ============ -->
      <section class="section section-dark" id="ubytovani">
        <div class="wrap">
          <header class="section-head reveal">
            <p class="kicker">Destinace</p>
            <h2 class="display">{oblasti.length > 0 ? 'Vyberte oblast' : 'Konkrétní hotely'}</h2>
            <p class="lead">
              {oblasti.length > 0
                ? 'Nabídka je rozdělená podle oblastí — vyberte si tu, která vám sedí.'
                : 'Výběr z aktuální nabídky, od cenově dostupných po ikonické adresy.'}
            </p>
          </header>

          {oblasti.length > 0 ? (
            <ul class="country-grid reveal" data-delay="1">
              {oblasti.map((o) => {
                const pocetHotelu = hotelyAll.filter((h2) => h2.data.nadrazena === o.id).length;
                return (
                  <li>
                    <a href={`${basePath}/${o.id}`}>
                      <div class="country-media">
                        {o.data.hlavni_foto ? (
                          <img class="country-photo" src={rel(o.data.hlavni_foto)} alt={o.data.nazev} loading="lazy" />
                        ) : (
                          <div class="hotel-photo-ph">⚠ Foto oblasti chybí — doplnit od klienta</div>
                        )}
                        <span class="country-badge">{pocetHotelu} {pocetHotelu === 1 ? 'hotel' : pocetHotelu >= 2 && pocetHotelu <= 4 ? 'hotely' : 'hotelů'}</span>
                        <span class="country-cta">Prohlédnout</span>
                      </div>
                      <div class="country-body">
                        <span class="country-name">{o.data.nazev}</span>
                      </div>
                    </a>
                  </li>
                );
              })}
            </ul>
          ) : hotelyPrime.length > 0 ? (
            <ul class="country-grid reveal" data-delay="1">
              {hotelyPrime.map((hotel) => (
                <li>
                  <a href={`${basePath}/${hotel.id}`}>
                    <div class="country-media">
                      {hotel.data.foto ? (
                        <img class="country-photo" src={rel(hotel.data.foto)} alt={hotel.data.nazev} loading="lazy" />
                      ) : (
                        <div class="hotel-photo-ph">⚠ Foto hotelu chybí — doplnit od klienta</div>
                      )}
                      {hotel.data.hvezdy && <span class="country-badge country-badge-left">{'★'.repeat(hotel.data.hvezdy)}</span>}
                      <span class="country-badge country-badge-right"><CenaTag cenaOd={hotel.data.cena_od} variant="karta" /></span>
                      <span class="country-cta">Prohlédnout</span>
                    </div>
                    <div class="country-body">
                      <span class="country-name">{hotel.data.nazev}</span>
                      {hotel.data.misto && <span class="country-sub">{hotel.data.misto}</span>}
                    </div>
                  </a>
                </li>
              ))}
            </ul>
          ) : (
            <div class="chybi-box reveal">
              <strong>⚠ Doplnit od klienta</strong>
              Konkrétní hotely tady zatím nemáme.
            </div>
          )}
        </div>
      </section>

      <!-- ============ FOTOGALERIE ============ -->
      {d!.galerie.length > 0 && (
        <section class="section" id="fotogalerie" style="background: var(--cream-2);">
          <div class="wrap">
            <header class="section-head reveal">
              <p class="kicker">Fotogalerie</p>
              <h2 class="display">{d!.nazev} v obrazech</h2>
            </header>
            <div class="reveal" data-delay="1">
              <PhotoSwiper images={d!.galerie} rel={rel} />
            </div>
          </div>
        </section>
      )}

      <!-- ============ KDY JET ============ -->
      {kind === 'destinace' && (
        <section class="section" id="kdy-jet" style="background: var(--cream-2);">
          <div class="wrap">
            <header class="section-head reveal">
              <p class="kicker">Kdy jet</p>
              <h2 class="display">Počasí po měsících</h2>
            </header>

            {d!.mapa && (
              <div class="live-weather reveal" data-delay="1" data-live-weather data-lat={d!.mapa.lat} data-lng={d!.mapa.lng}>
                <span class="live-weather-dot" aria-hidden="true"></span>
                <span class="live-weather-text">Načítám aktuální počasí…</span>
              </div>
            )}
            {d!.kdy_jet_poznamka && <p class="weather-note reveal" data-delay="2">{d!.kdy_jet_poznamka}</p>}

            {d!.kdy_jet.length > 0 ? (
              <div class="climate-table-wrap reveal" data-delay="3">
                <div class="climate-table">
                  <div class="climate-row climate-row-pill">
                    <span class="climate-label">Vzduch</span>
                    <div class="climate-pill">
                      {d!.kdy_jet.map((m) => <span class="climate-cell">{m.teplota_vzduch}</span>)}
                    </div>
                  </div>
                  <div class="climate-row">
                    <span class="climate-label">Měsíc</span>
                    <div class="climate-months">
                      {d!.kdy_jet.map((m) => <span class="climate-cell">{m.mesic}</span>)}
                    </div>
                  </div>
                  <div class="climate-row climate-row-pill">
                    <span class="climate-label">Moře</span>
                    <div class="climate-pill">
                      {d!.kdy_jet.map((m) => <span class="climate-cell">{m.teplota_more}</span>)}
                    </div>
                  </div>
                  {d!.kdy_jet.some((m) => m.srazky) && (
                    <div class="climate-row climate-row-pill">
                      <span class="climate-label">Srážky</span>
                      <div class="climate-pill">
                        {d!.kdy_jet.map((m) => <span class="climate-cell">{m.srazky || '—'}</span>)}
                      </div>
                    </div>
                  )}
                </div>
              </div>
            ) : (
              <div class="chybi-box reveal">
                <strong>⚠ Doplnit od klienta</strong>
                Počasí po měsících zatím nemáme.
              </div>
            )}
          </div>
        </section>
      )}

      <!-- ============ MAPA ============ -->
      {d!.mapa && <MapaMista lat={d!.mapa.lat} lng={d!.mapa.lng} zoom={d!.mapa.zoom} nazev={d!.nazev} />}

      <!-- ============ ZÁŽITKY ============ -->
      {kind === 'destinace' && d!.zazitky.length > 0 && (
        <section class="section" id="zazitky">
          <div class="wrap">
            <header class="section-head reveal">
              <p class="kicker">Co zažít</p>
              <h2 class="display">Zážitky a výlety</h2>
            </header>
            <div class="experience-grid reveal" data-delay="1">
              {d!.zazitky.map((z) => (
                <div class="experience-item">
                  <h3>{z.nazev}</h3>
                  <p>{z.popis}</p>
                </div>
              ))}
            </div>
          </div>
        </section>
      )}

      <!-- ============ GOLF ============ -->
      {kind === 'destinace' && d!.golf.length > 0 && (
        <section class="section" id="golf" style="background: var(--cream-2);">
          <div class="wrap">
            <header class="section-head reveal">
              <p class="kicker">Golf</p>
              <h2 class="display">Golfová hřiště</h2>
            </header>
            <div class="experience-grid reveal" data-delay="1">
              {d!.golf.map((g) => (
                <div class="experience-item">
                  <h3>{g.nazev}</h3>
                  <p>
                    {g.jamky ? `${g.jamky} jamek` : '⚠ Počet jamek chybí'}
                    {g.vzdalenost_hotel ? ` · ${g.vzdalenost_hotel} od hotelu` : ''}
                    {g.green_fee_v_cene === true ? ' · green fee v ceně' : ''}
                    {g.green_fee_v_cene === false ? ' · green fee mimo cenu' : ''}
                  </p>
                </div>
              ))}
            </div>
          </div>
        </section>
      )}

      <!-- ============ REFERENCE (js/dest-references.js) ============ -->
      {kind === 'destinace' && d!.ref_tag && (
        <section class="section ref-inline" id="reference" data-dest={d!.ref_tag} data-root="/">
          <div class="wrap">
            <header class="ref-inline-head reveal">
              <p class="kicker">Reference klientů</p>
              <h2 class="display">Co říkají ti, kdo tam&nbsp;byli</h2>
              <p class="lead">Skutečné dopisy od&nbsp;našich klientů, beze změny.</p>
            </header>

            <div class="ref-grid" data-ref-grid></div>

            <div class="ref-inline-more reveal">
              <a class="btn btn-ghost" data-ref-all href="reference">Všechny reference na&nbsp;{d!.nazev}</a>
            </div>
          </div>
        </section>
      )}

      <!-- ============ CO CHYBÍ (viditelný podklad k diskusi) ============ -->
      {d!.chybi.length > 0 && (
        <section class="section" style="padding-top: 0; padding-bottom: 60px;">
          <div class="wrap">
            <div class="chybi-box reveal">
              <strong>⚠ Doplnit od klienta — podklad k diskusi</strong>
              <ul>
                {d!.chybi.map((item) => <li>{item}</li>)}
              </ul>
            </div>
          </div>
        </section>
      )}

      <!-- ============ CTA BAND — kontakt ============ -->
      <section class="section dest-cta-band">
        <div class="wrap">
          <div class="dest-cta-inner reveal">
            <h2 class="display">Naplánujme spolu vaši cestu na {d!.nazev}</h2>
            <p>
              Bára Blaschke se vám ozve do 48 hodin s nabídkou na míru.
              <br />
              <a href="mailto:barbora@snailtravel.cz">barbora@snailtravel.cz</a>
              &nbsp;·&nbsp;
              <a href="tel:+420602552624">+420&nbsp;602&nbsp;552&nbsp;624</a>
            </p>
            <a href="#kontakt" class="btn btn-pill">Naplánovat cestu</a>
            {chain.length > 0 && (
              <p style="margin-top:18px;"><a href={`destinace/${chain.map((c) => c.id).join('/')}`}>&larr; Zpět na {chain[chain.length - 1].data.nazev}</a></p>
            )}
          </div>
        </div>
      </section>
    </>
  )}

</Base>

{kind !== 'hotel' && d?.galerie && d.galerie.length > 1 && (
  <script is:inline src="js/dest-hero-slider.js"></script>
)}
<script is:inline src="js/price-tag.js?v=1"></script>
<script is:inline src="js/photo-swiper.js?v=2"></script>
{kind === 'destinace' && <script is:inline src="js/weather-live.js?v=1"></script>}
