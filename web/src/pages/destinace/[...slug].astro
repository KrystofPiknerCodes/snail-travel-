---
// Jedna šablona pro celý strom Destinace/Oblast/Hotel (klientovo zadání:
// Hlavní strana > Destinace > Evropa > Madeira > Funchal > Hotel).
//
// URL segmenty i drobečková navigace se počítají generickým procházením
// `nadrazena` (web/src/lib/hierarchie.ts) do libovolné hloubky — přidání
// další destinace, oblasti nebo hotelu (i bez oblasti) proto nevyžaduje
// úpravu routeru, jen nový soubor v content/destinace nebo content/hotel.
import { getCollection, render } from 'astro:content';
import type { CollectionEntry } from 'astro:content';
import Base from '../../layouts/Base.astro';
import Rozcestnik from '../../components/Rozcestnik.astro';
import MapaMista from '../../components/MapaMista.astro';
import CenaTag from '../../components/CenaTag.astro';
import PhotoSwiper from '../../components/PhotoSwiper.astro';
import HotelCard from '../../components/HotelCard.astro';
import { czechNbsp } from '../../lib/typography';
import {
  indexDestinace,
  resolveAncestors,
  childOblasti,
  hotelyPod,
  buildBreadcrumb,
  resolveKontinent,
  KONTINENT_NAZEV,
  type DestEntry,
  type HotelEntry,
} from '../../lib/hierarchie';

// Kolik hotelů se v sekci "Zájezdy destinace" ukáže rovnou, zbytek je za
// tlačítkem "Zobrazit všechny" — stejný princip a stejné číslo jako
// VIDITELNYCH na /destinace (web/src/pages/destinace/index.astro).
const VIDITELNYCH_HOTELU = 6;

type Kind = 'destinace' | 'oblast' | 'hotel';

interface Props {
  kind: Kind;
  entry: DestEntry | HotelEntry;
  chain: DestEntry[];
  destinaceAll: DestEntry[];
  hotelyAll: HotelEntry[];
}

export async function getStaticPaths() {
  const destinaceAll = await getCollection('destinace');
  const hotelyAll = await getCollection('hotel');
  const destinaceById = indexDestinace(destinaceAll);

  const paths: Array<{ params: { slug: string }; props: Props }> = [];

  for (const entry of destinaceAll) {
    const chain = resolveAncestors(entry.data.nadrazena, destinaceById);
    const segments = [...chain.map((c) => c.id), entry.id];
    paths.push({
      params: { slug: segments.join('/') },
      props: {
        kind: entry.data.typ === 'oblast' ? 'oblast' : 'destinace',
        entry,
        chain,
        destinaceAll,
        hotelyAll,
      },
    });
  }

  for (const hotel of hotelyAll) {
    const chain = resolveAncestors(hotel.data.nadrazena, destinaceById);
    const segments = [...chain.map((c) => c.id), hotel.id];
    paths.push({
      params: { slug: segments.join('/') },
      props: { kind: 'hotel', entry: hotel, chain, destinaceAll, hotelyAll },
    });
  }

  return paths;
}

const { kind, entry, chain, destinaceAll, hotelyAll } = Astro.props as Props;
const { Content } = await render(entry as any);

const breadcrumb = buildBreadcrumb(entry, chain);
const kontinent = resolveKontinent(entry, chain);
const basePath = 'destinace/' + [...chain.map((c) => c.id), entry.id].join('/');
// GitHub Pages běží pod podadresářem (SITE_BASE, viz astro.config.mjs) — Base.astro
// nastavuje <base>, takže interní odkazy/obrázky musí být relativní (bez úvodního
// lomítka); absolutní cesty uložené v obsahu (např. hlavni_foto) je potřeba očistit.
const rel = (p?: string) => (p ? p.replace(/^\//, '') : '');

// ---- Destinace i Oblast sdílejí stejná data (obě žijí v kolekci `destinace`) ----
const d = kind !== 'hotel' ? (entry as DestEntry).data : null;

// Přímo podřazené oblasti (jen relevantní pro kind === 'destinace'/'oblast',
// oblast může mít v budoucnu vlastní podoblasti, i když to zadání nevyžaduje).
const oblasti = kind !== 'hotel' ? childOblasti(entry.id, destinaceAll) : [];

// Hotely přímo podřazené tomuto uzlu (bez mezičlánku oblasti).
const hotelyPrime = kind !== 'hotel' ? hotelyAll.filter((h) => h.data.nadrazena === entry.id) : [];
// "Destinace / Oblast" — stejné pro všechny karty v hotelyPrime, protože
// všechny leží přímo pod tímhle uzlem (viz komentář v HotelCard.astro).
const hotelyPrimeLokace = kind !== 'hotel' ? [...chain.map((c) => c.data.nazev), d?.nazev ?? ''].join(' / ') : '';

// Všechny hotely destinace napříč oblastmi (Funchal, Calheta, ...) na jednom
// místě pro sekci "Zájezdy destinace" níž — na rozdíl od hotelyPrime výš,
// který u destinace s oblastmi (Madeira) vyjde prázdný, protože hotely visí
// pod jednotlivými oblastmi, ne přímo pod destinací. Vykresluje se proto jen
// tehdy, když destinace oblasti MÁ (jinak by duplikovala sekci Ubytování,
// která bez oblastí hotelyPrime vypisuje sama). Na rozdíl od hotelyPrimeLokace
// výš je lokace per-hotel, protože hotely v tomhle seznamu leží pod různými
// oblastmi (basePath by fungoval jen pro hotely přímo pod entry).
const destinaceById = indexDestinace(destinaceAll);
const hotelyDestinace = kind === 'destinace' && oblasti.length > 0 ? hotelyPod(entry.id, hotelyAll, destinaceAll) : [];
const hotelHref = (hotel: HotelEntry) => {
  const hChain = resolveAncestors(hotel.data.nadrazena, destinaceById);
  return `destinace/${[...hChain.map((c) => c.id), hotel.id].join('/')}`;
};
const hotelLokace = (hotel: HotelEntry) =>
  resolveAncestors(hotel.data.nadrazena, destinaceById).map((c) => c.data.nazev).join(' / ');

// ---- Hotel ----
const h = kind === 'hotel' ? (entry as HotelEntry).data : null;
// Galerie pro PhotoSwiper — bez vyplněné `galerie` spadne na jediné `foto`,
// ať sekce "Fotografie hotelu" funguje i u hotelů, které galerii ještě nemají.
const hotelGalerie =
  h && h.galerie.length > 0 ? h.galerie : h?.foto ? [{ src: h.foto, alt: h.nazev }] : [];

// "Info" — všechny textové sekce hotelu pohromadě, jeden blok s "Přečíst
// více" (viz sekce INFO níž), ne rozsekané na samostatné sekce/kotvy.
// `ikona` je SVG path/tvary pro drobný piktogram před každým mezititulkem
// (na přání Krystof, září 2026 — "klidně u toho info taky přidej nějaké
// piktogramy"), stejný monoline styl jako ikony u Poznávejte/Relaxujte.
const hotelInfoText = h
  ? ([
      {
        nadpis: 'Poloha',
        text: h.poloha_text,
        ikona: '<circle cx="12" cy="10" r="3"/><path d="M12 21c-4-4.3-7-7.9-7-11a7 7 0 0 1 14 0c0 3.1-3 6.7-7 11z"/>',
      },
      {
        nadpis: 'Vybavení hotelu',
        text: h.vybaveni_hotelu,
        ikona: '<rect x="4" y="3" width="16" height="18" rx="1"/><path d="M9 8h1M14 8h1M9 12h1M14 12h1M9 16h2"/>',
      },
      {
        nadpis: 'Vybavení pokoje',
        text: h.vybaveni_pokoje,
        ikona: '<path d="M3 19v-6a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2v6"/><path d="M3 19v2M21 19v2M3 13V8a1 1 0 0 1 1-1h5a1 1 0 0 1 1 1v3"/>',
      },
      {
        nadpis: 'Stravování',
        text: h.stravovani,
        ikona: '<path d="M7 2v7a2 2 0 0 0 4 0V2M9 9v13M17 2c-1.4 0-2 1.3-2 3v4c0 1.1.9 2 2 2M17 2v18"/>',
      },
      {
        nadpis: 'Pláž',
        text: h.plaz,
        ikona: '<path d="M12 3c4.5 0 8 4 9 9H3c1-5 4.5-9 9-9zM12 3v18M9 21a2 2 0 0 0 4 0"/>',
      },
      {
        nadpis: 'Sport a zábava',
        text: h.sport_zabava,
        ikona: '<path d="M6 7v10M4 9v6M20 7v10M22 9v6M6 12h12"/>',
      },
    ].filter((s) => s.text) as Array<{ nadpis: string; text: string; ikona: string }>)
  : [];

// Hero fotka/slider nahoře stránky — dřív jen u destinace/oblasti, hotel
// tam měl jen text bez podkladu (viz komentář historie: kicker-light/.display
// jsou stylované na světlý text NAD fotkou, na hotelu tak bez fotky
// vycházel skoro nečitelný). Sjednoceno: hotel používá stejnou hero fotku/
// slider jako destinace, jen ze svojí galerie (`hotelGalerie` výš), ať jde
// později snadno rozšířit i o video (Krystofovo zadání, září 2026).
const heroFoto = kind === 'hotel' ? h?.foto : d?.hlavni_foto;
const heroGalerie = kind === 'hotel' ? hotelGalerie : (d?.galerie ?? []);

const tocItems =
  kind === 'destinace' && d
    ? ([
        (oblasti.length > 0 || hotelyPrime.length > 0) && { id: 'ubytovani', label: 'Destinace' },
        hotelyDestinace.length > 0 && { id: 'zajezdy', label: 'Zájezdy' },
        { id: 'info', label: 'Info' },
        d.galerie.length > 0 && { id: 'fotogalerie', label: 'Fotogalerie' },
        d.kdy_jet.length > 0 && { id: 'kdy-jet', label: 'Kdy jet' },
        d.mapa && { id: 'mapa', label: 'Mapa' },
        d.ref_tag && { id: 'reference', label: 'Reference' },
      ].filter(Boolean) as Array<{ id: string; label: string }>)
    : kind === 'hotel' && h
    ? ([
        hotelInfoText.length > 0 && { id: 'info', label: 'Info' },
        hotelGalerie.length > 0 && { id: 'fotogalerie', label: 'Fotogalerie' },
        h.poloha && { id: 'mapa', label: 'Mapa' },
        h.nas_nazor && { id: 'nas-nazor', label: 'Tip od šneků' },
      ].filter(Boolean) as Array<{ id: string; label: string }>)
    : [];

const pageTitle =
  kind === 'hotel'
    ? `${h!.nazev} — ${chain[chain.length - 1]?.data.nazev ?? ''} — Snail Travel`
    : `${d!.nazev} — Destinace — Snail Travel`;
const pageDescription =
  kind === 'hotel' ? `${h!.nazev}${h!.misto ? `, ${h!.misto}` : ''}` : d!.perex ?? d!.nazev;
---

<Base title={pageTitle} description={pageDescription} activeNav="destinace">

  <!-- ============ HERO ============ -->
  <section class={`section dest-head ${heroFoto ? 'dest-head-photo dest-head-slider' : ''}`}>
    {heroFoto && (
      kind === 'destinace' && heroGalerie.length > 1 ? (
        <div class="dest-hero-slider" id="destHeroSlider" aria-hidden="true">
          {heroGalerie.slice(0, 4).map((img, i) => (
            <div class={`dest-hero-slide ${i === 0 ? 'is-active' : ''}`} style={`background-image: url('${rel(img.src)}')`}></div>
          ))}
          <div class="dest-hero-overlay"></div>
          <div class="dest-hero-dots">
            {heroGalerie.slice(0, 4).map((_, i) => (
              <button type="button" class={`dest-hero-dot ${i === 0 ? 'is-active' : ''}`} data-slide={i} aria-label={`Fotka ${i + 1}`}></button>
            ))}
          </div>
        </div>
      ) : (
        <div class="dest-head-bg" style={`background-image: url('${rel(heroFoto)}')`} aria-hidden="true"></div>
      )
    )}
    <div class="wrap">
      <nav class="crumb reveal" aria-label="Drobečková navigace">
        {breadcrumb.map((c, i) => (
          <>
            {i > 0 && <span class="crumb-sep">/</span>}
            {c.href ? <a href={c.href}>{c.label}</a> : <span class="crumb-current">{c.label}</span>}
          </>
        ))}
      </nav>

      {kind === 'hotel' ? (
        <>
          <p class="kicker kicker-light reveal" data-delay="1">
            Hotel{h!.misto ? ` · ${h!.misto}` : ''}
          </p>
          <h1 class="display reveal" data-delay="2">{h!.nazev}</h1>
          <div class="hotel-hero-meta reveal" data-delay="3">
            {h!.hvezdy ? (
              <div class="hotel-stars">
                <span class="country-stars-on">{'★'.repeat(h!.hvezdy)}</span><span class="country-stars-off">{'★'.repeat(5 - h!.hvezdy)}</span>
              </div>
            ) : <span />}
            <CenaTag cenaOd={h!.cena_od} variant="hero" />
          </div>
        </>
      ) : (
        <>
          <p class="kicker kicker-light reveal" data-delay="1">
            {kind === 'oblast'
              ? `Oblast · ${chain.map((c) => c.data.nazev).join(' · ')}`
              : `Destinace · ${kontinent ? KONTINENT_NAZEV[kontinent] : ''}${chain.length === 0 && d?.nadrazena ? ` · ${d.nadrazena}` : ''}`}
          </p>
          <h1 class="display reveal" data-delay="2">{d!.nazev}</h1>
        </>
      )}
    </div>
  </section>

  {(kind === 'destinace' || kind === 'hotel') && <Rozcestnik items={tocItems} />}

  {kind === 'hotel' ? (
    <>
      <!-- ============ INFO — všechny textové sekce hotelu (Poloha, Vybavení,
           Stravování...) spojené do jednoho bloku s náhledem a "Přečíst
           více", stejný akordeonový princip jako Poznávejte/Relaxujte u
           destinace. Na přání Krystof, září 2026: "to info mělo být
           všechno dohromady, ne to rozsekat na sekce". ============ -->
      {hotelInfoText.length > 0 && (
        <section class="section dest-accordion-section" id="info" style="background: var(--cream-2); --fade-to: var(--cream-2);">
          <div class="wrap">
            <div class="dest-accordion-head reveal">
              <h2 class="display">Info</h2>
            </div>
            <div class="dest-accordion" data-collapse>
              <div class="dest-accordion-panel" data-collapse-panel>
                <div class="dest-accordion-inner">
                  {hotelInfoText.map(({ nadpis, text, ikona }) => (
                    <>
                      <h3>
                        <svg class="dest-info-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" set:html={ikona} />
                        {nadpis}
                      </h3>
                      <p>{czechNbsp(text)}</p>
                    </>
                  ))}
                </div>
              </div>
              <button
                type="button"
                class="dest-intro-more"
                data-collapse-trigger
                data-label-more="Přečíst více ↓"
                data-label-less="Skrýt ↑"
              >
                Přečíst více ↓
              </button>
            </div>
          </div>
        </section>
      )}

      <!-- ============ FOTOGALERIE ============ -->
      <section class="section" id="fotogalerie">
        <div class="wrap">
          {hotelGalerie.length > 0 ? (
            <PhotoSwiper images={hotelGalerie} rel={rel} />
          ) : (
            <div class="hotel-photo-ph" style="height:320px;">⚠ Foto hotelu chybí — doplnit od klienta</div>
          )}
        </div>
      </section>

      <!-- ============ MAPA ============ -->
      {h!.poloha && (
        <MapaMista lat={h!.poloha.lat} lng={h!.poloha.lng} zoom={15} nazev={h!.nazev} />
      )}

      <!-- ============ TIP OD ŠNEKŮ ============ -->
      {h!.nas_nazor && (
        <section class="section" id="nas-nazor">
          <div class="wrap dest-intro">
            <div class="dest-intro-head reveal">
              <h2 class="display">Tip od šneků</h2>
            </div>
            <div class="dest-intro-text-full reveal" data-delay="1">
              <p>{czechNbsp(h!.nas_nazor)}</p>
            </div>
          </div>
        </section>
      )}

      <!-- ============ CTA ============ -->
      <section class="section dest-cta-band">
        <div class="wrap">
          <div class="dest-cta-inner reveal">
            <h2 class="display">Naplánujme spolu pobyt v {h!.nazev}</h2>
            <p>
              Bára Blaschke se vám ozve do 48 hodin s nabídkou na míru.
              <br />
              <a href="mailto:barbora@snailtravel.cz">barbora@snailtravel.cz</a>
              &nbsp;·&nbsp;
              <a href="tel:+420602552624">+420&nbsp;602&nbsp;552&nbsp;624</a>
            </p>
            <a href="#kontakt" class="btn btn-pill">Naplánovat cestu</a>
            <p style="margin-top:18px;"><a href={`destinace/${[...chain.map((c) => c.id)].join('/')}`}>&larr; Zpět na {chain[chain.length - 1]?.data.nazev}</a></p>
          </div>
        </div>
      </section>
    </>
  ) : (
    <>
      <!-- ============ UBYTOVÁNÍ (oblasti, nebo přímo hotely, pokud oblast chybí). Sekce se
           nevykreslí vůbec, když není ani jedno — stejná podmínka jako u položky
           v tocItems výš, ať nezůstane prázdná sekce s "doplnit od klienta". ============ -->
      {(oblasti.length > 0 || hotelyPrime.length > 0) && (
      <section class="section section-dark" id="ubytovani">
        <div class="wrap">
          <header class="section-head reveal">
            <p class="kicker">Destinace</p>
            <h2 class="display">{oblasti.length > 0 ? 'Vyberte oblast' : 'Konkrétní hotely'}</h2>
            <p class="lead">
              {oblasti.length > 0
                ? 'Nabídka je rozdělená podle oblastí — vyberte si tu, která vám sedí.'
                : 'Výběr z aktuální nabídky, od cenově dostupných po ikonické adresy.'}
            </p>
          </header>

          {oblasti.length > 0 ? (
            <ul class="country-grid reveal" data-delay="1">
              {oblasti.map((o) => {
                const pocetHotelu = hotelyAll.filter((h2) => h2.data.nadrazena === o.id).length;
                return (
                  <li>
                    <a href={`${basePath}/${o.id}`}>
                      <div class="country-media">
                        {o.data.hlavni_foto ? (
                          <img class="country-photo" src={rel(o.data.hlavni_foto)} alt={o.data.nazev} loading="lazy" />
                        ) : (
                          <div class="hotel-photo-ph">⚠ Foto oblasti chybí — doplnit od klienta</div>
                        )}
                        <span class="country-badge">{pocetHotelu} {pocetHotelu === 1 ? 'hotel' : pocetHotelu >= 2 && pocetHotelu <= 4 ? 'hotely' : 'hotelů'}</span>
                        <span class="country-cta">Prohlédnout</span>
                      </div>
                      <div class="country-body">
                        <span class="country-name">{o.data.nazev}</span>
                      </div>
                    </a>
                  </li>
                );
              })}
            </ul>
          ) : (
            <ul class="country-grid reveal" data-delay="1">
              {hotelyPrime.map((hotel) => (
                <HotelCard hotel={hotel} href={`${basePath}/${hotel.id}`} lokace={hotelyPrimeLokace} rel={rel} />
              ))}
            </ul>
          )}
        </div>
      </section>
      )}

      <!-- ============ ZÁJEZDY DESTINACE — všechny hotely napříč oblastmi
           (Funchal, Calheta, ...) na jednom místě, ne rozdělené jako sekce
           Ubytování výš. Prvních VIDITELNYCH_HOTELU vidět rovnou, zbytek za
           tlačítkem "Zobrazit všechny" — stejný .country-grid + is-more
           mechanismus jako na /destinace (web/public/js/dest-hotel-toggle.js). ============ -->
      {hotelyDestinace.length > 0 && (
      <section class="section" id="zajezdy">
        <div class="wrap">
          <header class="section-head reveal">
            <p class="kicker">Nabídka</p>
            <h2 class="display">Zájezdy destinace {d!.nazev}</h2>
            <p class="lead">Všechny hotely, které na {d!.nazev} nabízíme, od cenově dostupných po ikonické adresy.</p>
          </header>

          <ul class="country-grid reveal" data-delay="1" id="zajezdyGrid">
            {hotelyDestinace.map((hotel, i) => (
              <HotelCard
                hotel={hotel}
                href={hotelHref(hotel)}
                lokace={hotelLokace(hotel)}
                rel={rel}
                class={i >= VIDITELNYCH_HOTELU ? 'is-more' : ''}
              />
            ))}
          </ul>

          {hotelyDestinace.length > VIDITELNYCH_HOTELU && (
            <div class="cta-row country-grid-cta">
              <button class="btn btn-ghost country-grid-toggle" type="button" aria-expanded="false" aria-controls="zajezdyGrid">
                <span class="btn-ghost-label">Zobrazit všechny hotely ({hotelyDestinace.length})</span>
              </button>
            </div>
          )}
        </div>
      </section>
      )}

      <!-- ============ INFO — krátký úvod nalevo, text napravo s "Přečíst více"
           (js/dest-collapse.js — sdílený mechanismus i pro Poznávejte/Relaxujte
           níž, jen jiné CSS chování: tady jde o odstín/clamp, u akordeonů o
           úplné sbalení). ============ -->
      <section class="section" id="info">
        <div class="wrap">
          <p class="kicker reveal">Info</p>
          <div class="dest-intro">
          <div class="dest-intro-head reveal">
            <h2 class="display">{d!.nazev}</h2>
          </div>
          <div class="dest-intro-body reveal" data-delay="1" data-collapse>
            <div class="dest-intro-text" data-collapse-panel>
              <Content />
            </div>
            <button
              type="button"
              class="dest-intro-more"
              data-collapse-trigger
              data-label-more="Přečíst více ↓"
              data-label-less="Skrýt ↑"
            >
              Přečíst více ↓
            </button>
          </div>
          </div>
        </div>
      </section>

      <!-- ============ POZNÁVEJTE (akordeon, sbalené ve výchozím stavu) ============ -->
      {kind === 'destinace' && d!.poznavejte && (
        <section class="section dest-accordion-section" id="poznavejte" style="background: var(--cream-2); --fade-to: var(--cream-2);">
          <div class="wrap">
            <div class="dest-accordion-head reveal">
              <span class="dest-accordion-trigger-label">
                <span class="icon-circle" aria-hidden="true">
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
                    <circle cx="12" cy="12" r="10" />
                    <polygon points="16.24 7.76 14.12 14.12 7.76 16.24 9.88 9.88 16.24 7.76" />
                  </svg>
                </span>
                <h2 class="display">Poznávejte</h2>
              </span>
            </div>
            <div class="dest-accordion" data-collapse>
              <div class="dest-accordion-panel" data-collapse-panel>
                <div class="dest-accordion-inner">
                  <p>{czechNbsp(d!.poznavejte.text)}</p>
                  {(d!.poznavejte.tipy.length > 0 || d!.poznavejte.svatky.length > 0) && (
                    <div class="dest-accordion-lists">
                      {d!.poznavejte.tipy.length > 0 && (
                        <div class="dest-accordion-col">
                          <h3>Co si nenechat ujít</h3>
                          <ul>{d!.poznavejte.tipy.map((t) => <li>{czechNbsp(t)}</li>)}</ul>
                        </div>
                      )}
                      {d!.poznavejte.svatky.length > 0 && (
                        <div class="dest-accordion-col">
                          <h3>Svátky a festivaly</h3>
                          <ul>{d!.poznavejte.svatky.map((s) => <li>{czechNbsp(s)}</li>)}</ul>
                        </div>
                      )}
                    </div>
                  )}
                </div>
              </div>
              <button
                type="button"
                class="dest-intro-more"
                data-collapse-trigger
                data-label-more="Přečíst více ↓"
                data-label-less="Skrýt ↑"
              >
                Přečíst více ↓
              </button>
            </div>
          </div>
        </section>
      )}

      <!-- ============ RELAXUJTE (akordeon, sbalené ve výchozím stavu). Golf
           nemá vlastní sekci — jen sloupec tady, viz rozhodnutí Krystof, září
           2026 (jedno hřiště/destinaci nezaslouží samostatnou sekci v navigaci). ============ -->
      {kind === 'destinace' && (d!.relaxujte || d!.golf.length > 0) && (
        <section class="section dest-accordion-section" id="relaxujte">
          <div class="wrap">
            <div class="dest-accordion-head reveal">
              <span class="dest-accordion-trigger-label">
                <span class="icon-circle" aria-hidden="true">
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
                    <circle cx="12" cy="12" r="5" />
                    <path d="M12 1v2M12 21v2M4.22 4.22l1.42 1.42M18.36 18.36l1.42 1.42M1 12h2M21 12h2M4.22 19.78l1.42-1.42M18.36 5.64l1.42-1.42" />
                  </svg>
                </span>
                <h2 class="display">Relaxujte</h2>
              </span>
            </div>
            <div class="dest-accordion" data-collapse>
              <div class="dest-accordion-panel" data-collapse-panel>
                <div class="dest-accordion-inner">
                  {d!.relaxujte && <p>{czechNbsp(d!.relaxujte.text)}</p>}
                  {(d!.relaxujte?.mista_koupani.length || d!.golf.length > 0) && (
                    <div class="dest-accordion-lists">
                      {!!d!.relaxujte?.mista_koupani.length && (
                        <div class="dest-accordion-col">
                          <h3>Místa na koupání</h3>
                          <ul>{d!.relaxujte!.mista_koupani.map((m) => <li>{czechNbsp(m)}</li>)}</ul>
                        </div>
                      )}
                      {d!.golf.length > 0 && (
                        <div class="dest-accordion-col">
                          <h3>Golfová hřiště</h3>
                          <ul>
                            {d!.golf.map((g) => (
                              <li>
                                {g.nazev}
                                {g.jamky ? ` — ${g.jamky} jamek` : ''}
                                {g.vzdalenost_hotel ? ` · ${g.vzdalenost_hotel} od hotelu` : ''}
                                {g.green_fee_v_cene === true ? ' · green fee v ceně' : ''}
                                {g.green_fee_v_cene === false ? ' · green fee mimo cenu' : ''}
                              </li>
                            ))}
                          </ul>
                        </div>
                      )}
                    </div>
                  )}
                </div>
              </div>
              <button
                type="button"
                class="dest-intro-more"
                data-collapse-trigger
                data-label-more="Přečíst více ↓"
                data-label-less="Skrýt ↑"
              >
                Přečíst více ↓
              </button>
            </div>
          </div>
        </section>
      )}

      <!-- ============ FOTOGALERIE ============ -->
      {d!.galerie.length > 0 && (
        <section class="section" id="fotogalerie" style="background: var(--cream-2);">
          <div class="wrap">
            <header class="section-head reveal">
              <p class="kicker">Fotogalerie</p>
              <h2 class="display">{d!.nazev} v obrazech</h2>
            </header>
            <div class="reveal" data-delay="1">
              <PhotoSwiper images={d!.galerie} rel={rel} />
            </div>
          </div>
        </section>
      )}

      <!-- ============ KDY JET ============ -->
      {kind === 'destinace' && d!.kdy_jet.length > 0 && (
        <section class="section" id="kdy-jet" style="background: var(--cream-2);">
          <div class="wrap">
            <header class="section-head reveal">
              <p class="kicker">Kdy jet</p>
              <h2 class="display">Počasí po měsících</h2>
            </header>

            {d!.mapa && (
              <div class="live-weather reveal" data-delay="1" data-live-weather data-lat={d!.mapa.lat} data-lng={d!.mapa.lng}>
                <span class="live-weather-dot" aria-hidden="true"></span>
                <span class="live-weather-text">Načítám aktuální počasí…</span>
                <a class="live-weather-credit" href="https://www.met.no/" target="_blank" rel="noopener">zdroj: MET Norway</a>
              </div>
            )}
            {d!.kdy_jet_poznamka && <p class="weather-note reveal" data-delay="2">{d!.kdy_jet_poznamka}</p>}

            <div class="climate-table-wrap reveal" data-delay="3">
              <div class="climate-table">
                <div class="climate-row climate-row-pill">
                  <span class="climate-label">Vzduch</span>
                  <div class="climate-pill">
                    {d!.kdy_jet.map((m) => <span class="climate-cell">{m.teplota_vzduch}</span>)}
                  </div>
                </div>
                <div class="climate-row">
                  <span class="climate-label">Měsíc</span>
                  <div class="climate-months">
                    {d!.kdy_jet.map((m) => <span class="climate-cell">{m.mesic}</span>)}
                  </div>
                </div>
                <div class="climate-row climate-row-pill">
                  <span class="climate-label">Moře</span>
                  <div class="climate-pill">
                    {d!.kdy_jet.map((m) => <span class="climate-cell">{m.teplota_more}</span>)}
                  </div>
                </div>
                {d!.kdy_jet.some((m) => m.srazky) && (
                  <div class="climate-row climate-row-pill">
                    <span class="climate-label">Srážky</span>
                    <div class="climate-pill">
                      {d!.kdy_jet.map((m) => <span class="climate-cell">{m.srazky || '—'}</span>)}
                    </div>
                  </div>
                )}
              </div>
            </div>
          </div>
        </section>
      )}

      <!-- ============ MAPA ============ -->
      {d!.mapa && <MapaMista lat={d!.mapa.lat} lng={d!.mapa.lng} zoom={d!.mapa.zoom} nazev={d!.nazev} />}

      <!-- ============ REFERENCE (js/dest-references.js) ============ -->
      {kind === 'destinace' && d!.ref_tag && (
        <section class="section ref-inline" id="reference" data-dest={d!.ref_tag} data-root="/">
          <div class="wrap">
            <header class="ref-inline-head reveal">
              <p class="kicker">Reference klientů</p>
              <h2 class="display">Co říkají ti, kdo tam&nbsp;byli</h2>
              <p class="lead">Skutečné dopisy od&nbsp;našich klientů, beze změny.</p>
            </header>

            <div class="ref-grid" data-ref-grid></div>

            <div class="ref-inline-more reveal">
              <a class="btn btn-ghost" data-ref-all href="reference">Všechny reference na&nbsp;{d!.nazev}</a>
            </div>
          </div>
        </section>
      )}


      <!-- ============ CTA BAND — kontakt ============ -->
      <section class="section dest-cta-band">
        <div class="wrap">
          <div class="dest-cta-inner reveal">
            <h2 class="display">Naplánujme spolu vaši cestu na {d!.nazev}</h2>
            <p>
              Bára Blaschke se vám ozve do 48 hodin s nabídkou na míru.
              <br />
              <a href="mailto:barbora@snailtravel.cz">barbora@snailtravel.cz</a>
              &nbsp;·&nbsp;
              <a href="tel:+420602552624">+420&nbsp;602&nbsp;552&nbsp;624</a>
            </p>
            <a href="#kontakt" class="btn btn-pill">Naplánovat cestu</a>
            {chain.length > 0 && (
              <p style="margin-top:18px;"><a href={`destinace/${chain.map((c) => c.id).join('/')}`}>&larr; Zpět na {chain[chain.length - 1].data.nazev}</a></p>
            )}
          </div>
        </div>
      </section>
    </>
  )}

</Base>

{kind === 'destinace' && heroGalerie.length > 1 && (
  <script is:inline src="js/dest-hero-slider.js"></script>
)}
<script is:inline src="js/price-tag.js?v=1"></script>
<script is:inline src="js/photo-swiper.js?v=2"></script>
{kind === 'destinace' && <script is:inline src="js/weather-live.js?v=2"></script>}
{(kind === 'destinace' || kind === 'hotel') && <script is:inline src="js/dest-collapse.js?v=1"></script>}
{hotelyDestinace.length > VIDITELNYCH_HOTELU && <script is:inline src="js/dest-hotel-toggle.js?v=1"></script>}
