---
import Ikona from '../components/Ikona.astro';
import Base from '../layouts/Base.astro';
import { nejnovejsiClanek, BLOG_URL } from '../lib/blog';

// Nejnovější článek z blogu — načte se při buildu (viz src/lib/blog.ts).
const clanek = await nejnovejsiClanek();
const clanekDatum = clanek?.datum
  ? clanek.datum.toLocaleDateString('cs-CZ', { day: 'numeric', month: 'long', year: 'numeric' })
  : '';
---
<Base
  title="Snail Travel — Exkluzivní cestování na míru"
  description="Snail Travel — soukromé luxusní cesty navržené do posledního detailu. Umění cestovat pomalu."
  transparentHero
>

  <!-- ============ HERO ============ -->
  <section class="hero" id="hero">
    <div class="hero-media">
      <!-- Mix stockových klipů (Pexels, volná licence) v assets/hero/, střídá je main.js po 4,5 s.
           Až dorazí finální video od klienta, nahradit (viz CLAUDE.md). Poster = první snímek prvního klipu. -->
      <div class="hero-video-zoom is-active">
        <video class="hero-video is-active" autoplay muted loop playsinline preload="auto" poster="assets/hero-poster.jpg?v=2">
          <source src="assets/hero/more-laguna.mp4?v=2" type="video/mp4" />
        </video>
        <video class="hero-video" muted loop playsinline preload="metadata">
          <source src="assets/hero/afrika-sloni.mp4?v=2" type="video/mp4" />
        </video>
        <video class="hero-video" muted loop playsinline preload="metadata">
          <source src="assets/hero/japonsko-fudzi.mp4?v=2" type="video/mp4" />
        </video>
        <video class="hero-video" muted loop playsinline preload="metadata">
          <source src="assets/hero/maledivy-resort.mp4?v=2" type="video/mp4" />
        </video>
        <video class="hero-video" muted loop playsinline preload="metadata">
          <source src="assets/hero/turecko-kapadokie.mp4?v=2" type="video/mp4" />
        </video>
        <video class="hero-video" muted loop playsinline preload="metadata">
          <source src="assets/hero/seychely-balvany.mp4?v=2" type="video/mp4" />
        </video>
      </div>
      <div class="hero-scrim"></div>
    </div>

    <div class="hero-content">
      <p class="kicker kicker-light reveal">Exkluzivní cestování na míru</p>
      <h1 class="hero-title reveal" data-delay="1">Vítejte ve Snail Travel</h1>
      <p class="hero-sub reveal" data-delay="2">
        Soukromé cesty navržené do posledního detailu. Pro ty, kdo nechtějí
        svět jen vidět&nbsp;— ale skutečně zažít.
      </p>
      <a href="#destinace" class="btn btn-outline-light reveal" data-delay="3">Objevte naše cesty</a>
    </div>

    <a href="#filozofie" class="hero-scroll" aria-label="Posunout dolů">
      <span>Posuňte níže</span>
      <span class="hero-scroll-line"></span>
    </a>
  </section>

  <!-- ============ FILOZOFIE ============ -->
  <section class="section philosophy" id="filozofie">
    <div class="wrap philosophy-grid">
      <div class="philosophy-left reveal">
        <p class="kicker">Naše filozofie</p>
        <h2 class="display">Nespěcháme.<br />A&nbsp;právě v&nbsp;tom je luxus.</h2>
      </div>
      <div class="philosophy-right reveal" data-delay="1">
        <p class="lead">
          Inspirováni hlemýžděm neseme svět s&nbsp;sebou — beze spěchu, s&nbsp;pokorou
          a&nbsp;citem pro detail.
        </p>
        <p>
          Každá cesta Snail Travel je tkána ručně. Nečekané místo k&nbsp;večeři,
          soukromý průvodce, který zná příběhy za rohem, ráno bez budíku.
          Nenabízíme itineráře — vytváříme vzpomínky, ke kterým se budete vracet.
        </p>
        <ul class="philosophy-list">
          <li>Cesty navržené výhradně pro vás</li>
          <li>Pečlivě vybraná místa mimo dosah davů</li>
          <li>Osobní concierge po celou dobu cesty</li>
        </ul>
      </div>
    </div>
  </section>

  <!-- ============ DESTINACE ============ -->
  <section class="section destinations section-dark" id="destinace">
    <div class="wrap">
      <header class="section-head reveal">
        <p class="kicker">Destinace</p>
        <h2 class="display">Kam vás vezmeme</h2>
      </header>

    <div class="bento dest-bento reveal">
        <a class="tile" data-fit="cover" href="destinace/madeira">
          <div class="tile-media"><img class="tile-img" src="assets/dest-madeira.jpg" onerror="this.onerror=null;this.src='assets/ph-madeira.svg'" alt="Kvetoucí bugenvilie nad pobřežím Funchalu" loading="lazy" /><span class="tile-cta">Zobrazit nabídky</span></div>
          <div class="tile-body">
            <h3 class="tile-title">Madeira</h3>
            <p class="tile-desc">Dramatické útesy a&nbsp;věčné jaro</p>
          </div>
        </a>

        <a class="tile" data-fit="cover" href="destinace/turecko">
          <div class="tile-media"><img class="tile-img" src="assets/dest-turecko.jpg" onerror="this.onerror=null;this.src='assets/countries/ph-turecko.svg'" alt="Skalní útvary v Kapadokii za úsvitu" loading="lazy" /><span class="tile-cta">Zobrazit nabídky</span></div>
          <div class="tile-body">
            <h3 class="tile-title">Turecko</h3>
            <p class="tile-desc">Kapadokie za úsvitu a&nbsp;tyrkysové pobřeží Egejského moře</p>
          </div>
        </a>

        <a class="tile" data-fit="cover" href="destinace/azorske-ostrovy">
          <div class="tile-media"><img class="tile-img" src="assets/dest-azory.jpg" onerror="this.onerror=null;this.src='assets/ph-azory.svg'" alt="Zelené kopce a pobřeží Azor" loading="lazy" /><span class="tile-cta">Zobrazit nabídky</span></div>
          <div class="tile-body">
            <h3 class="tile-title">Azorské ostrovy</h3>
            <p class="tile-desc">Zelené krátery uprostřed Atlantiku</p>
          </div>
        </a>

        <a class="tile" data-fit="cover" href="destinace/maledivy">
          <div class="tile-media"><img class="tile-img" src="assets/dest-maledivy.jpg" onerror="this.onerror=null;this.src='assets/ph-maledivy.svg'" alt="Vodní vily na Maledivách" loading="lazy" /><span class="tile-cta">Zobrazit nabídky</span></div>
          <div class="tile-body">
            <h3 class="tile-title">Maledivy</h3>
            <p class="tile-desc">Vily nad&nbsp;křišťálovou lagunou</p>
          </div>
        </a>

        <a class="tile" data-fit="cover" href="destinace/mauritius">
          <div class="tile-media"><img class="tile-img" src="assets/dest-mauritius.jpg" onerror="this.onerror=null;this.src='assets/ph-mauritius.svg'" alt="Letecký pohled na tyrkysovou lagunu Mauricia" loading="lazy" /><span class="tile-cta">Zobrazit nabídky</span></div>
          <div class="tile-body">
            <h3 class="tile-title">Mauritius</h3>
            <p class="tile-desc">Bílé pláže a&nbsp;korálové útesy</p>
          </div>
        </a>

        <a class="tile" data-fit="cover" href="destinace/italie">
          <div class="tile-media"><img class="tile-img" src="assets/dest-italie.jpg" onerror="this.onerror=null;this.src='assets/countries/ph-italie.svg'" alt="Koloseum v Římě" loading="lazy" /><span class="tile-cta">Zobrazit nabídky</span></div>
          <div class="tile-body">
            <h3 class="tile-title">Itálie</h3>
            <p class="tile-desc">Řím, Toskánsko a&nbsp;pobřeží, které si budete pamatovat</p>
          </div>
        </a>
    </div>

    <div class="dest-foot reveal">
      <a class="btn btn-ghost" href="destinace">Všechny destinace</a>
    </div>
    </div>
  </section>

  <!-- ============ PROČ SNAIL TRAVEL / PILÍŘE ============ -->
  <section class="section pillars" id="proc-snail">
    <div class="wrap">
      <header class="section-head reveal">
        <p class="kicker">Proč Snail Travel</p>
        <h2 class="display">Cestování bez kompromisů</h2>
      </header>

      <div class="pillar-grid">
        <div class="pillar reveal" data-kubai-trigger>
          <Ikona name="compass" size={52} class="pillar-icon" />
          <h3>Na míru</h3>
          <p>Žádné dvě cesty nejsou stejné. Vše tvoříme od základu podle vašich přání a&nbsp;tempa.</p>
        </div>

        <div class="pillar reveal" data-kubai-trigger data-delay="1">
          <Ikona name="lock" size={52} class="pillar-icon" />
          <h3>Soukromí</h3>
          <p>Diskrétnost a&nbsp;exkluzivní přístup k&nbsp;místům, kam se běžný cestovatel nedostane.</p>
        </div>

        <div class="pillar reveal" data-kubai-trigger data-delay="2">
          <Ikona name="hourglass" size={52} class="pillar-icon" />
          <h3>Čas</h3>
          <p>Dáváme vám prostor cestu skutečně prožít — bez spěchu, bez kompromisů.</p>
        </div>

        <div class="pillar reveal" data-kubai-trigger data-delay="3">
          <Ikona name="phone" size={52} class="pillar-icon" />
          <h3>Osobní vztah</h3>
          <p>Kdykoli nám zavoláte, telefon vám zvedne jedna z nás z týmu Snail Travel. Bez robotů. 24 hodin denně, 7 dní v týdnu.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- ============ ZÁŽITKY (BENTO GRID) ============ -->
  <section class="section experiences" id="zazitky">
    <div class="wrap">
      <header class="section-head reveal">
        <p class="kicker">Populární zážitky</p>
        <h2 class="display">Zážitky, které si pamatujete<br />ještě roky poté</h2>
        <p class="lead">Mnoho způsobů, jak může vypadat vaše příští cesta — vybíráme nevšední zážitky.</p>
      </header>

      <div class="bento reveal">
        <a class="tile" data-fit="cover" href="#kontakt">
          <div class="tile-media"><img class="tile-img" src="assets/zaz-golf.jpg" onerror="this.onerror=null;this.src='assets/ph-zaz-golf.svg'" alt="Golfové hřiště lemované palmami v luxusním resortu" loading="lazy" /><span class="tile-cta">Zobrazit nabídky</span></div>
          <div class="tile-body">
            <p class="tile-cat">Golf</p>
            <div class="tile-rule"></div>
            <h3 class="tile-title">Golf</h3>
            <p class="tile-desc">Hřiště s&nbsp;výhledem, který odvádí pozornost od&nbsp;skóre.</p>
          </div>
        </a>
        <a class="tile" data-fit="cover" href="#kontakt">
          <div class="tile-media"><img class="tile-img" src="assets/zaz-f1.jpg" onerror="this.onerror=null;this.src='assets/ph-zaz-f1.svg'" alt="Formule 1 na okruhu" loading="lazy" /><span class="tile-cta">Zobrazit nabídky</span></div>
          <div class="tile-body">
            <p class="tile-cat">Formule 1</p>
            <h3 class="tile-title">Formule 1</h3>
            <p class="tile-desc">Adrenalin z&nbsp;první řady, bez front a&nbsp;davu.</p>
          </div>
        </a>
        <a class="tile" href="#kontakt">
          <div class="tile-media"><img class="tile-img" src="assets/zaz-euro.jpg" onerror="this.onerror=null;this.src='assets/ph-zaz-euro.svg'" alt="Eiffelova věž a Paříž za slunečného dne" loading="lazy" /><span class="tile-cta">Zobrazit nabídky</span></div>
          <div class="tile-body">
            <p class="tile-cat">City break</p>
            <h3 class="tile-title">Eurovíkendy</h3>
            <p class="tile-desc">Evropské metropole na&nbsp;pár dní, beze spěchu.</p>
          </div>
        </a>
        <a class="tile" data-fit="cover" href="#kontakt">
          <div class="tile-media"><img class="tile-img" src="assets/zaz-poznavani.jpg" onerror="this.onerror=null;this.src='assets/ph-zaz-poznavani.svg'" alt="Poznávací cesta historickým místem" loading="lazy" /><span class="tile-cta">Zobrazit nabídky</span></div>
          <div class="tile-body">
            <p class="tile-cat">Poznávání</p>
            <h3 class="tile-title">Poznávání</h3>
            <p class="tile-desc">Historie a&nbsp;kultura se&nbsp;soukromým průvodcem.</p>
          </div>
        </a>
        <a class="tile" data-fit="cover" href="#kontakt">
          <div class="tile-media"><img class="tile-img" src="assets/zaz-svatby.jpg" onerror="this.onerror=null;this.src='assets/ph-zaz-svatby.svg'" alt="Svatba v zahraničí" loading="lazy" /><span class="tile-cta">Zobrazit nabídky</span></div>
          <div class="tile-body">
            <p class="tile-cat">Svatby</p>
            <h3 class="tile-title">Svatební cesty</h3>
            <p class="tile-desc">Váš den, na&nbsp;místě, které si budete pamatovat navždy.</p>
          </div>
        </a>
        <a class="tile" data-fit="cover" href="#kontakt">
          <div class="tile-media"><img class="tile-img" src="assets/zaz-wellness.jpg" onerror="this.onerror=null;this.src='assets/ph-zaz-wellness.svg'" alt="Luxusní wellness resort" loading="lazy" /><span class="tile-cta">Zobrazit nabídky</span></div>
          <div class="tile-body">
            <p class="tile-cat">Wellness</p>
            <h3 class="tile-title">Wellness</h3>
            <p class="tile-desc">Dny beze spěchu, věnované jen sobě.</p>
          </div>
        </a>
      </div>

      <div class="bento bento-extra" id="bentoExtra">
        <a class="tile" href="#kontakt">
          <div class="tile-media"><img class="tile-img" src="assets/zaz-lety.jpg" onerror="this.onerror=null;this.src='assets/ph-zaz-lety.svg'" alt="Soukromé letadlo" loading="lazy" /><span class="tile-cta">Zobrazit nabídky</span></div>
          <div class="tile-body">
            <p class="tile-cat">Private jet</p>
            <h3 class="tile-title">Privátní lety</h3>
            <p class="tile-desc">Nebe bez front, bez čekání, bez kompromisů.</p>
          </div>
        </a>
        <a class="tile" href="#kontakt">
          <div class="tile-media"><img class="tile-img" src="assets/zaz-safari.jpg" onerror="this.onerror=null;this.src='assets/ph-zaz-safari.svg'" alt="Safari v africké savaně" loading="lazy" /><span class="tile-cta">Zobrazit nabídky</span></div>
          <div class="tile-body">
            <p class="tile-cat">Safari</p>
            <h3 class="tile-title">Safari</h3>
            <p class="tile-desc">Buš, tichem rušená jen křikem ptáků, a&nbsp;stan, který nikdo jiný nesdílí.</p>
          </div>
        </a>
        <a class="tile" href="#kontakt">
          <div class="tile-media"><img class="tile-img" src="assets/zaz-allinclusive.jpg" onerror="this.onerror=null;this.src='assets/ph-zaz-allinclusive.svg'" alt="Luxusní all inclusive resort" loading="lazy" /><span class="tile-cta">Zobrazit nabídky</span></div>
          <div class="tile-body">
            <p class="tile-cat">All inclusive</p>
            <h3 class="tile-title">All inclusive</h3>
            <p class="tile-desc">Luxus, kde se nic neřeší — jen si vybíráte, co&nbsp;dál.</p>
          </div>
        </a>
        <a class="tile" href="#kontakt">
          <div class="tile-media"><img class="tile-img" src="assets/zaz-vily.jpg" onerror="this.onerror=null;this.src='assets/ph-zaz-vily.svg'" alt="Soukromá vila u moře" loading="lazy" /><span class="tile-cta">Zobrazit nabídky</span></div>
          <div class="tile-body">
            <p class="tile-cat">Vily</p>
            <h3 class="tile-title">Luxusní vily</h3>
            <p class="tile-desc">Dům, který se stará o&nbsp;všechno kromě vzpomínek.</p>
          </div>
        </a>
        <a class="tile" href="#kontakt">
          <div class="tile-media"><img class="tile-img" src="assets/zaz-vlaky.jpg" onerror="this.onerror=null;this.src='assets/ph-zaz-vlaky.svg'" alt="Luxusní vlak" loading="lazy" /><span class="tile-cta">Zobrazit nabídky</span></div>
          <div class="tile-body">
            <p class="tile-cat">Luxusní vlaky</p>
            <h3 class="tile-title">Luxusní vlaky</h3>
            <p class="tile-desc">Krajina plyne za oknem, čas plyne jinak.</p>
          </div>
        </a>
        <a class="tile" href="#kontakt">
          <div class="tile-media"><img class="tile-img" src="assets/zaz-plavby.jpg" onerror="this.onerror=null;this.src='assets/ph-zaz-plavby.svg'" alt="Soukromá jachta na moři" loading="lazy" /><span class="tile-cta">Zobrazit nabídky</span></div>
          <div class="tile-body">
            <p class="tile-cat">Yachting</p>
            <h3 class="tile-title">Luxusní plavby</h3>
            <p class="tile-desc">Ne&nbsp;turistická trasa — vaše vlastní souřadnice.</p>
          </div>
        </a>
        <a class="tile" href="#kontakt">
          <div class="tile-media"><img class="tile-img" src="assets/zaz-rodina.jpg" onerror="this.onerror=null;this.src='assets/ph-zaz-rodina.svg'" alt="Rodinná dovolená" loading="lazy" /><span class="tile-cta">Zobrazit nabídky</span></div>
          <div class="tile-body">
            <p class="tile-cat">Rodina</p>
            <h3 class="tile-title">Cestování s&nbsp;dětmi</h3>
            <p class="tile-desc">Dobrodružství pro všechny generace najednou.</p>
          </div>
        </a>
        <a class="tile" href="#kontakt">
          <div class="tile-media"><img class="tile-img" src="assets/zaz-lyzovani.jpg" onerror="this.onerror=null;this.src='assets/ph-zaz-lyzovani.svg'" alt="Heli-skiing v horách" loading="lazy" /><span class="tile-cta">Zobrazit nabídky</span></div>
          <div class="tile-body">
            <p class="tile-cat">Heli-skiing</p>
            <h3 class="tile-title">Heliskiing</h3>
            <p class="tile-desc">Svah, který jste si sami objevili.</p>
          </div>
        </a>
        <a class="tile" href="#kontakt">
          <div class="tile-media"><img class="tile-img" src="assets/zaz-gastronomie.jpg" onerror="this.onerror=null;this.src='assets/ph-zaz-gastronomie.svg'" alt="Degustace vína a gastronomie" loading="lazy" /><span class="tile-cta">Zobrazit nabídky</span></div>
          <div class="tile-body">
            <p class="tile-cat">Gastronomie</p>
            <h3 class="tile-title">Gastronomie</h3>
            <p class="tile-desc">Chutě, které vyprávějí příběh místa.</p>
          </div>
        </a>
        <a class="tile" href="#kontakt">
          <div class="tile-media"><img class="tile-img" src="assets/zaz-adults.jpg" onerror="this.onerror=null;this.src='assets/ph-zaz-adults.svg'" alt="Adults only resort" loading="lazy" /><span class="tile-cta">Zobrazit nabídky</span></div>
          <div class="tile-body">
            <p class="tile-cat">Adults only</p>
            <h3 class="tile-title">Adults only</h3>
            <p class="tile-desc">Ticho, které nenaruší nikdo jiný než vlny.</p>
          </div>
        </a>
        <a class="tile" data-fit="cover" href="#kontakt">
          <div class="tile-media"><img class="tile-img" src="assets/zaz-wow.jpg" onerror="this.onerror=null;this.src='assets/ph-zaz-wow.svg'" alt="Bazén s výhledem na moře ve wow hotelu" loading="lazy" /><span class="tile-cta">Zobrazit nabídky</span></div>
          <div class="tile-body">
            <p class="tile-cat">WOW hotely</p>
            <h3 class="tile-title">WOW hotely</h3>
            <p class="tile-desc">Nocleh, který je sám o&nbsp;sobě zážitkem.</p>
          </div>
        </a>
        <a class="tile" href="#kontakt">
          <div class="tile-media"><img class="tile-img" src="assets/zaz-events.jpg" onerror="this.onerror=null;this.src='assets/ph-zaz-events.svg'" alt="VIP vstupenky na akci" loading="lazy" /><span class="tile-cta">Zobrazit nabídky</span></div>
          <div class="tile-body">
            <p class="tile-cat">Vstupenky</p>
            <h3 class="tile-title">Vstupenky na&nbsp;akce</h3>
            <p class="tile-desc">Nejlepší místa na akce, kam se běžně nedostanete.</p>
          </div>
        </a>
      </div>

      <div class="cta-row reveal">
        <button class="btn btn-ghost" id="bentoToggle" type="button" aria-expanded="false" aria-controls="bentoExtra">
          <span class="btn-ghost-label">Všechny zážitky</span>
        </button>
      </div>
    </div>
  </section>

  <!-- ============ Z BLOGU (nejnovější článek z blog.snailtravel.cz) ============
       Krystof 28. 11. 2026: ukázka nejnovějšího článku, ať na něj lidé
       kliknou. Data z RSS při buildu (src/lib/blog.ts); když blog není
       dostupný, sekce se nevykreslí. Blog je samostatný web → nové okno. -->
  {clanek && (
    <section class="section blog-teaser" id="blog">
      <div class="wrap">
        <header class="section-head reveal">
          <p class="kicker">Z našeho blogu</p>
          <h2 class="display">Inspirace a zprávy<br />z našich cest</h2>
        </header>
        <a class="blog-card reveal" href={clanek.odkaz} target="_blank" rel="noopener">
          <div class="blog-card-media">
            {clanek.obrazek
              ? <img src={clanek.obrazek} alt="" loading="lazy" width="1038" height="576" />
              : <img src="assets/footer-bg.jpg" alt="" loading="lazy" />}
          </div>
          <div class="blog-card-body">
            {clanek.kategorie[0] && <p class="blog-card-cat">{clanek.kategorie[0]}</p>}
            <h3 class="blog-card-title">{clanek.nazev}</h3>
            {clanek.perex && <p class="blog-card-perex">{clanek.perex}</p>}
            <p class="blog-card-meta">{[clanek.autor, clanekDatum].filter(Boolean).join(' · ')}</p>
            <span class="blog-card-cta">Přečíst článek <span aria-hidden="true">→</span></span>
          </div>
        </a>
        <div class="cta-row reveal"><a class="btn btn-ghost" href={BLOG_URL} target="_blank" rel="noopener">Všechny články na blogu</a></div>
      </div>
    </section>
  )}

  <!-- ============ CITÁT / PARALLAX ============ -->
  <section class="quote-band">
    <div class="quote-bg" data-parallax></div>
    <blockquote class="quote reveal">
      „Cestování není únik. Je&nbsp;to návrat k&nbsp;sobě.&rdquo;
    </blockquote>
  </section>

  <!-- ============ KONTAKT ============ -->
  <section class="section contact" id="kontakt">
    <div class="wrap contact-grid">
      <div class="contact-intro reveal">
        <p class="kicker">Začněme</p>
        <h2 class="display">Naplánujte<br />svou cestu</h2>
        <p class="contact-text">
          Řekněte nám, kam vás to láká. Náš travel designér se vám ozve do&nbsp;48&nbsp;hodin
          a&nbsp;připraví vám návrh cesty — nezávazně a&nbsp;diskrétně.
        </p>
        <div class="contact-details">
          <a href="mailto:info@snailtravel.cz">info@snailtravel.cz</a>
          <a href="tel:+420602552624">+420&nbsp;602&nbsp;552&nbsp;624</a>
        </div>
      </div>

      <form class="contact-form reveal" data-delay="1" novalidate>
        <div class="field">
          <label for="name">Jméno</label>
          <input type="text" id="name" name="name" autocomplete="name" required />
        </div>
        <div class="field">
          <label for="email">E‑mail</label>
          <input type="email" id="email" name="email" autocomplete="email" required />
        </div>
        <div class="field-row">
          <div class="field">
            <label for="kdy">Kdy chcete cestovat?</label>
            <input type="text" id="kdy" name="kdy" placeholder="např. květen 2027" autocomplete="off" />
          </div>
          <div class="field">
            <label for="pocet">Kolik vás pojede?</label>
            <input type="text" id="pocet" name="pocet" placeholder="např. 2 dospělí" autocomplete="off" />
          </div>
        </div>
        <div class="field">
          <label for="message">Kam vás to láká?</label>
          <textarea id="message" name="message" rows="3" required></textarea>
        </div>
        <div class="field">
          <label for="prani">Máte speciální přání?</label>
          <textarea id="prani" name="prani" rows="2"></textarea>
        </div>
        <button type="submit" class="btn btn-solid">Odeslat poptávku</button>
        <p class="form-hint">Poptávka je nezávazná.</p>
        <p class="form-note" id="formNote" role="status" aria-live="polite"></p>
      </form>
    </div>
  </section>

</Base>

<script is:inline src="js/kontakt-prefill.js?v=1"></script>
