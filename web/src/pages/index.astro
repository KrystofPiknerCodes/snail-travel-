---
import Base from '../layouts/Base.astro';
---
<Base title="Snail Travel — Astro verze (rozpracováno)" activeNav="">
  <section class="section">
    <div class="wrap" style="max-width: 720px; text-align: center;">
      <p class="kicker">Rozpracováno</p>
      <h1 class="display">Astro verze webu Snail Travel</h1>
      <p class="lead" style="margin-top: 18px; color: var(--ink-soft);">
        Tohle je nová verze webu postavená nad obsahovými kolekcemi — zatím
        obsahuje jen detail destinace Madeira jako ukázku. Hlavička a patička
        jsou sdílené (<code>src/layouts/Base.astro</code>), obsah destinace
        žije v <code>src/content/destinace/madeira.md</code>. Plná homepage,
        seznam destinací a reference zatím zůstávají na starém webu.
      </p>
      <p style="margin-top: 30px;">
        <a class="btn btn-pill" href="/destinace/madeira">Zobrazit destinaci Madeira →</a>
      </p>
    </div>
  </section>
</Base>
